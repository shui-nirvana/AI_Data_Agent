# Set a private token before starting the API.
# This shared demo identity is not production authentication.
# Do not put secrets in this example or expose the demo to the public internet.
AI_AGENT_DEMO_TOKEN=replace-with-a-long-random-secret

# Data directory for SQLite and uploads.
AI_AGENT_DATA_DIR=.runtime

# Maximum CSV upload size in bytes (10 MiB here).
AI_AGENT_MAX_UPLOAD_BYTES=10485760

# The deployment label does not select an execution backend or prove deployment.
AI_AGENT_DEPLOYMENT_PLATFORM=local
# The API defaults to disabled; the Docker worker runs independently.
AI_AGENT_EXECUTION_BACKEND=disabled
# Keep the API disabled; enable a provider only for the Graph Runner.
AI_AGENT_LLM_PROVIDER=disabled
AI_AGENT_LLM_MODEL=
# Runner: AI_AGENT_LLM_PROVIDER=deepseek, AI_AGENT_LLM_MODEL=deepseek-flash
# Explicitly authorize external model requests; see docs/security.md for the full disclosure.
AI_AGENT_LLM_ALLOW_EXTERNAL=false
# DeepSeek reads the process environment first, then the root .env.deepseek file.
# This example contains no real secrets; a plain .env is not loaded automatically.
DEEPSEEK_API_KEY=
# For Vultr, set AI_AGENT_LLM_PROVIDER=vultr and choose the actual model ID.
# The inference key may be stored in ignored .env.vultr; it is not an account management key.
VULTR_SERVERLESS_INFERENCE_API_KEY=

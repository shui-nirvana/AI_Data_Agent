# 在启动 API 之前设置私有令牌。
# 注意：这只是一个简单的演示账户，并非生产环境鉴权。
# 请勿在此处输入敏感数据或将其暴露在公网。
AI_AGENT_DEMO_TOKEN=replace-with-a-long-random-secret

# 数据持久化目录（存储 SQLite 和上传的文件）
AI_AGENT_DATA_DIR=.runtime

# 最大允许上传的 CSV 字节数（此处为 10MB）
AI_AGENT_MAX_UPLOAD_BYTES=10485760

# 部署标识（local/vultr/aws 等）不选择执行方式，也不证明部署已完成。
AI_AGENT_DEPLOYMENT_PLATFORM=local
# API 默认 disabled；Docker 开发 worker 独立运行，不由 API 自动启用。
AI_AGENT_EXECUTION_BACKEND=disabled
# API 保持 disabled；以下 DeepSeek 配置只在 Graph Runner 终端启用。
AI_AGENT_LLM_PROVIDER=disabled
AI_AGENT_LLM_MODEL=
# Runner: AI_AGENT_LLM_PROVIDER=deepseek, AI_AGENT_LLM_MODEL=deepseek-flash
# 显式授权匿名规范/计数外发；默认 false，无原始行/列名/真实填充值。
AI_AGENT_LLM_ALLOW_EXTERNAL=false
# DeepSeek 适配器优先读取进程环境，否则读取项目根目录的 .env.deepseek。
# 本示例不存真实密钥，普通 .env 不自动加载。
DEEPSEEK_API_KEY=

# Include this file inside nginx's http context after configuring the domain and certificate paths.
limit_req_zone $binary_remote_addr zone=agent_requests:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=agent_connections:10m;

server {
    listen 80;
    server_name agent.example.com;
    access_log off;
    return 308 https://agent.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name agent.example.com;

    ssl_certificate /etc/letsencrypt/live/agent.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agent.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;

    client_max_body_size 10m;
    client_header_timeout 15s;
    client_body_timeout 15s;
    limit_req zone=agent_requests burst=20 nodelay;
    limit_req_status 429;
    limit_conn agent_connections 20;
    limit_conn_status 429;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# The build script supplies the pulled and recorded Python image digest; do not deploy a mutable tag.
ARG PYTHON_BASE
FROM ${PYTHON_BASE}
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# Dependencies are installed at build time only; jobs have no network or dependency installation.
COPY deploy/requirements-job.lock /app/requirements-job.lock
RUN pip install --no-cache-dir --require-hashes -r /app/requirements-job.lock
COPY backend/domain /app/backend/domain
COPY backend/__init__.py /app/backend/__init__.py
COPY images /app/images
USER 10001:10001
# Keep PID 1 alive so restricted tmpfs output remains readable after the exec job.
# The worker forcibly removes this container after completion, timeout, or cancellation; it is not reused.
CMD ["python", "-c", "import time; time.sleep(86400)"]
